# Optional: LOCALLY managed Cloudflare Tunnel running on the HOST.
#
# cloudflared is NOT containerised in this deployment. It runs on the host and
# dials the two containers through the host network namespace:
#
#   app.example.com    → http://127.0.0.1:8080   (frontend, plain HTTP)
#   relay.example.com  → http://127.0.0.1:8000/ws only (relay, plain HTTP+WS)
#
# This is the precise alternative to a token-based (remotely managed) tunnel.
# It is recommended when you want the relay's /metrics and /healthz to be
# UNREACHABLE from the internet by construction, instead of relying on a CF WAF
# rule. The `path: /ws` rule is load-bearing: the relay's /metrics route accepts
# a loopback peer, and host cloudflared IS loopback, so forwarding every path to
# port 8000 would expose metrics publicly.
#
# Setup on the host:
#   1. `cloudflared tunnel create owlshelf` → note the tunnel UUID.
#   2. Copy this file to /etc/cloudflared/config.yml and the generated
#      credentials JSON next to it (both root-owned, mode 0600/0644).
#   3. `cloudflared tunnel route dns owlshelf app.example.com`
#      `cloudflared tunnel route dns owlshelf relay.example.com`
#   4. `systemctl enable --now cloudflared` (or however you manage the service).
#      No container, no TUNNEL_TOKEN, no ingress change in compose.yaml.

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  # The PWA. Plain HTTP on 127.0.0.1:8080 — CF terminates TLS.
  - hostname: app.example.com
    service: http://127.0.0.1:8080

  # The WebSocket relay. Enable WebSockets for this hostname in CF.
  - hostname: relay.example.com
    path: /ws
    service: http://127.0.0.1:8000

  # Anything else is dropped, including /metrics and /healthz on the relay.
  - service: http_status:404
